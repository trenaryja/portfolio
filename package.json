{
	"name": "portfolio",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"check": "tsc && pnpm lint && pnpm format -c && pnpm build",
		"format": "prettier -w . !\"pnpm-lock.yaml\"",
		"get-latest": "pnpm up -L -i -r",
		"reinstall": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm install",
		"screenshot": "pnpm dlx tsx scripts/screenshot.ts"
	},
	"dependencies": {
		"@emailjs/browser": "^4.4.1",
		"@mantine/hooks": "^8.3.10",
		"@trenaryja/ui": "0.0.1-31",
		"@tsparticles/react": "^3.0.0",
		"@tsparticles/slim": "^3.9.1",
		"clsx": "^2.1.1",
		"culori": "^4.0.2",
		"daisyui": "^5.5.14",
		"next": "^16.0.10",
		"next-themes": "^0.4.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-icons": "^5.5.0",
		"remeda": "^2.32.0",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.3",
		"@next/eslint-plugin-next": "^16.0.10",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/culori": "^4.0.1",
		"@types/node": "^25.0.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "^19.2.3",
		"eslint": "9.39.2",
		"eslint-config-next": "^16.0.10",
		"prettier": "3.7.4",
		"puppeteer": "^24.33.0",
		"tailwindcss": "^4.1.18",
		"typescript": "5.9.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"@tsparticles/engine",
			"puppeteer",
			"sharp",
			"unrs-resolver"
		]
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"printWidth": 120,
		"jsxSingleQuote": true,
		"useTabs": true
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	}
}
