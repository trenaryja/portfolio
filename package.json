		"@tsparticles/slim": "^4.3.2",
		"clsx": "^2.1.1",
		"culori": "^4.0.2",
		"daisyui": "^5.7.17",
		"next": "^16.3.1",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"remeda": "^2.40.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@trenaryja/config": "^0.0.1",
		"@types/culori": "^4.0.1",
		"@types/node": "^26.2.0",
