{
	"name": "portfolio",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"check": "tsc && bun run lint && bun run format -c && bun run build",
		"format": "prettier -w . !\"bun.lock\"",
		"get-latest": "bun update --latest -i",
		"reinstall": "rm -rf node_modules && rm bun.lock && bun install",
		"screenshot": "bunx tsx scripts/screenshot.ts"
	},
	"dependencies": {
		"@emailjs/browser": "^4.4.1",
		"@mantine/hooks": "^9.5.1",
		"@trenaryja/ui": "0.0.1-37",
		"@tsparticles/react": "^3.0.0",
		"@tsparticles/slim": "^3.9.1",
		"clsx": "^2.1.1",
		"culori": "^4.0.2",
		"daisyui": "^5.7.16",
		"next": "^16.3.0",
		"next-themes": "^0.4.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "^5.7.0",
		"remeda": "^2.39.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
		"@next/eslint-plugin-next": "^16.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/culori": "^4.0.1",
		"@types/node": "^26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "^19.2.4",
		"eslint": "9.39.2",
		"eslint-config-next": "^16.3.0",
		"prettier": "3.9.6",
		"puppeteer": "^25.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "5.9.3"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"printWidth": 120,
		"jsxSingleQuote": true,
		"useTabs": true
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	}
}
